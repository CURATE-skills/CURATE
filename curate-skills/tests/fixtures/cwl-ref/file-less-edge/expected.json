{
 "jobs": {
  "name": "t_flow",
  "description": "t_flow",
  "defaults": {
   "image": "docker:///python:3.12-slim",
   "resources": {
    "cpus": 1,
    "memory_mb": 2048
   }
  },
  "inputs": [],
  "outputs": [
   {
    "file": "a__output1__1__p_1.txt",
    "deliver_as": "results/p_1.txt"
   },
   {
    "file": "a__output1__2__p_2.txt",
    "deliver_as": "results/p_2.txt"
   },
   {
    "file": "b__output1__1__q_1.txt",
    "deliver_as": "results/q_1.txt"
   },
   {
    "file": "b__output1__2__q_2.txt",
    "deliver_as": "results/q_2.txt"
   }
  ],
  "nodes": [
   {
    "id": "a__1",
    "_origin": "a",
    "_assign": {
     "rank2": "1"
    },
    "code": "functions/a.py",
    "entrypoint": "main",
    "inputs": {},
    "outputs": {
     "output1": "a__output1__1__p_1.txt"
    },
    "params": {
     "rank": 1,
     "max_rank": 2
    }
   },
   {
    "id": "a__2",
    "_origin": "a",
    "_assign": {
     "rank2": "2"
    },
    "code": "functions/a.py",
    "entrypoint": "main",
    "inputs": {},
    "outputs": {
     "output1": "a__output1__2__p_2.txt"
    },
    "params": {
     "rank": 2,
     "max_rank": 2
    }
   },
   {
    "id": "b__1",
    "_origin": "b",
    "_assign": {
     "rank2": "1"
    },
    "code": "functions/b.py",
    "entrypoint": "main",
    "inputs": {},
    "outputs": {
     "output1": "b__output1__1__q_1.txt"
    },
    "params": {
     "rank": 1,
     "max_rank": 2
    },
    "after": [
     "a__1",
     "a__2"
    ]
   },
   {
    "id": "b__2",
    "_origin": "b",
    "_assign": {
     "rank2": "2"
    },
    "code": "functions/b.py",
    "entrypoint": "main",
    "inputs": {},
    "outputs": {
     "output1": "b__output1__2__q_2.txt"
    },
    "params": {
     "rank": 2,
     "max_rank": 2
    },
    "after": [
     "a__1",
     "a__2"
    ]
   }
  ],
  "_base": "<fixture>"
 },
 "pegasus": {
  "workflow": {
   "pegasus": "5.0.4",
   "name": "t",
   "metadata": {
    "curate.transformations": "{\"a\": {\"image\": \"docker:///python:3.12-slim\", \"resources\": {\"cpus\": 1, \"memory_mb\": 2048}}, \"b\": {\"image\": \"docker:///python:3.12-slim\", \"resources\": {\"cpus\": 1, \"memory_mb\": 2048}}}",
    "curate.replicas": "{\"code__a__a.py\": \"functions/a.py\", \"code__b__b.py\": \"functions/b.py\"}",
    "curate.deliverables": "[{\"file\": \"a__output1__1__p_1.txt\", \"deliver_as\": \"results/p_1.txt\"}, {\"file\": \"a__output1__2__p_2.txt\", \"deliver_as\": \"results/p_2.txt\"}, {\"file\": \"b__output1__1__q_1.txt\", \"deliver_as\": \"results/q_1.txt\"}, {\"file\": \"b__output1__2__q_2.txt\", \"deliver_as\": \"results/q_2.txt\"}]"
   },
   "jobs": [
    {
     "type": "job",
     "name": "a",
     "id": "a__1",
     "arguments": [
      "--code",
      "code__a__a.py",
      "--entrypoint",
      "main",
      "--out",
      "output1=a__output1__1__p_1.txt",
      "--params-json",
      "'{\"rank\": 1, \"max_rank\": 2}'"
     ],
     "uses": [
      {
       "lfn": "code__a__a.py",
       "type": "input"
      },
      {
       "lfn": "a__output1__1__p_1.txt",
       "type": "output",
       "stageOut": true,
       "registerReplica": true
      }
     ]
    },
    {
     "type": "job",
     "name": "a",
     "id": "a__2",
     "arguments": [
      "--code",
      "code__a__a.py",
      "--entrypoint",
      "main",
      "--out",
      "output1=a__output1__2__p_2.txt",
      "--params-json",
      "'{\"rank\": 2, \"max_rank\": 2}'"
     ],
     "uses": [
      {
       "lfn": "code__a__a.py",
       "type": "input"
      },
      {
       "lfn": "a__output1__2__p_2.txt",
       "type": "output",
       "stageOut": true,
       "registerReplica": true
      }
     ]
    },
    {
     "type": "job",
     "name": "b",
     "id": "b__1",
     "arguments": [
      "--code",
      "code__b__b.py",
      "--entrypoint",
      "main",
      "--out",
      "output1=b__output1__1__q_1.txt",
      "--params-json",
      "'{\"rank\": 1, \"max_rank\": 2}'"
     ],
     "uses": [
      {
       "lfn": "code__b__b.py",
       "type": "input"
      },
      {
       "lfn": "b__output1__1__q_1.txt",
       "type": "output",
       "stageOut": true,
       "registerReplica": true
      }
     ]
    },
    {
     "type": "job",
     "name": "b",
     "id": "b__2",
     "arguments": [
      "--code",
      "code__b__b.py",
      "--entrypoint",
      "main",
      "--out",
      "output1=b__output1__2__q_2.txt",
      "--params-json",
      "'{\"rank\": 2, \"max_rank\": 2}'"
     ],
     "uses": [
      {
       "lfn": "code__b__b.py",
       "type": "input"
      },
      {
       "lfn": "b__output1__2__q_2.txt",
       "type": "output",
       "stageOut": true,
       "registerReplica": true
      }
     ]
    }
   ],
   "jobDependencies": [
    {
     "id": "a__1",
     "children": [
      "b__1",
      "b__2"
     ]
    },
    {
     "id": "a__2",
     "children": [
      "b__1",
      "b__2"
     ]
    }
   ]
  },
  "copy": {},
  "needed": []
 },
 "faasr": {
  "workflow": {
   "FunctionInvoke": "a",
   "WorkflowName": "t",
   "DefaultDataStore": "S3",
   "LoggingDataStore": "S3",
   "FaaSrLog": "FaaSrLog",
   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "a": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "a",
     "Arguments": {
      "folder": "tf",
      "output1": "a__output1__{rank}__p_{rank}.txt"
     },
     "InvokeNext": [
      "b(2)"
     ]
    },
    "b": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "b",
     "Arguments": {
      "folder": "tf",
      "output1": "b__output1__{rank}__q_{rank}.txt"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "a": "ghcr.io/faasr/github-actions-python:latest",
    "b": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
     "Region": "<FAASR_S3_REGION>",
     "AccessKey": "S3_AccessKey",
     "SecretKey": "S3_SecretKey",
     "Writable": "TRUE"
    }
   },
   "FunctionGitRepo": {
    "a": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/a.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/a_main.py"
    ],
    "b": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/b.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/b_main.py"
    ]
   }
  },
  "names": {
   "a/output1": "a__output1__{rank}__p_{rank}.txt",
   "b/output1": "b__output1__{rank}__q_{rank}.txt"
  },
  "outputs": {
   "files": [
    {
     "action": "a",
     "file": "a__output1__1__p_1.txt"
    },
    {
     "action": "a",
     "file": "a__output1__2__p_2.txt"
    },
    {
     "action": "b",
     "file": "b__output1__1__q_1.txt"
    },
    {
     "action": "b",
     "file": "b__output1__2__q_2.txt"
    }
   ],
   "deliverables": [
    {
     "output": "p_rank2_txt",
     "file": "a__output1__1__p_1.txt",
     "deliver_as": "results/p_1.txt"
    },
    {
     "output": "p_rank2_txt",
     "file": "a__output1__2__p_2.txt",
     "deliver_as": "results/p_2.txt"
    },
    {
     "output": "q_rank2_txt",
     "file": "b__output1__1__q_1.txt",
     "deliver_as": "results/q_1.txt"
    },
    {
     "output": "q_rank2_txt",
     "file": "b__output1__2__q_2.txt",
     "deliver_as": "results/q_2.txt"
    }
   ]
  },
  "external_inputs": []
 }
}
