 "faasr": {
  "workflow": {
   "FunctionInvoke": "a",
   "WorkflowName": "t",
   "DefaultDataStore": "S3",
   "LoggingDataStore": "S3",
   "FaaSrLog": "FaaSrLog",
   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "a": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "a",
     "Arguments": {
      "folder": "tf",
      "output1": "a__output1__{rank}__p_{rank}.txt"
     },
     "InvokeNext": [
      "b(2)"
     ]
    },
    "b": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "b",
     "Arguments": {
      "folder": "tf",
      "output1": "b__output1__{rank}__q_{rank}.txt"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "a": "ghcr.io/faasr/github-actions-python:latest",
    "b": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
     "Region": "<FAASR_S3_REGION>",
     "AccessKey": "S3_AccessKey",
     "SecretKey": "S3_SecretKey",
     "Writable": "TRUE"
    }
   },
   "FunctionGitRepo": {
    "a": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/a.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/a_main.py"
    ],
    "b": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/b.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/b_main.py"
    ]
   }
  },
  "names": {
   "a/output1": "a__output1__{rank}__p_{rank}.txt",
   "b/output1": "b__output1__{rank}__q_{rank}.txt"
  },
  "outputs": {
   "files": [
    {
     "action": "a",
