   "LoggingDataStore": "S3",
   "FaaSrLog": "FaaSrLog",
   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "download-ghcn-station": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "download_ghcn_station",
     "Arguments": {
      "folder": "tf",
      "output1": "download_ghcn_station__output1__USC00351862_daily.csv"
     },
     "InvokeNext": [
      "process-weather-variable(3)"
     ]
    },
    "process-weather-variable": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "process_weather_variable",
     "Arguments": {
      "folder": "tf",
      "input1": "download_ghcn_station__output1__USC00351862_daily.csv",
      "output1": "process_weather_variable__output1__{rank}__winter_comparison_{rank}.csv"
     },
     "InvokeNext": [
      "plot-weather-comparison"
     ]
    },
    "plot-weather-comparison": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "plot_weather_comparison",
     "Arguments": {
      "folder": "tf",
      "input1": "process_weather_variable__output1__{rank}__winter_comparison_{rank}.csv",
      "output1": "plot_weather_comparison__output1__corvallis_winter_comparison.png"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "download-ghcn-station": "ghcr.io/faasr/github-actions-python:latest",
    "process-weather-variable": "ghcr.io/faasr/github-actions-python:latest",
    "plot-weather-comparison": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
     "Region": "<FAASR_S3_REGION>",
     "AccessKey": "S3_AccessKey",
     "SecretKey": "S3_SecretKey",
     "Writable": "TRUE"
    }
   },
   "FunctionGitRepo": {
