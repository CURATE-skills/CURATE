    "inputs": {},
    "outputs": {
     "output1": "download_ghcn_station__output1__USC00351862_daily.csv"
    },
    "params": {},
    "packages": [
     "requests"
    ]
   },
   {
    "id": "process_weather_variable__1",
    "_origin": "process_weather_variable",
    "_assign": {
     "rank3": "1"
    },
    "code": "functions/process_weather_variable.py",
    "entrypoint": "main",
    "inputs": {
     "input1": "download_ghcn_station__output1__USC00351862_daily.csv"
    },
    "outputs": {
     "output1": "process_weather_variable__output1__1__winter_comparison_1.csv"
    },
    "params": {
     "rank": 1,
     "max_rank": 3
    },
    "packages": [
     "pandas"
    ]
   },
   {
    "id": "process_weather_variable__2",
    "_origin": "process_weather_variable",
    "_assign": {
     "rank3": "2"
    },
    "code": "functions/process_weather_variable.py",
    "entrypoint": "main",
    "inputs": {
     "input1": "download_ghcn_station__output1__USC00351862_daily.csv"
    },
    "outputs": {
     "output1": "process_weather_variable__output1__2__winter_comparison_2.csv"
    },
    "params": {
     "rank": 2,
     "max_rank": 3
    },
    "packages": [
     "pandas"
    ]
   },
   {
    "id": "process_weather_variable__3",
    "_origin": "process_weather_variable",
    "_assign": {
     "rank3": "3"
    },
    "code": "functions/process_weather_variable.py",
    "entrypoint": "main",
    "inputs": {
     "input1": "download_ghcn_station__output1__USC00351862_daily.csv"
    },
    "outputs": {
     "output1": "process_weather_variable__output1__3__winter_comparison_3.csv"
    },
    "params": {
     "rank": 3,
     "max_rank": 3
    },
    "packages": [
     "pandas"
    ]
   },
   {
    "id": "plot_weather_comparison",
    "_origin": "plot_weather_comparison",
    "_assign": {},
    "code": "functions/plot_weather_comparison.py",
    "entrypoint": "main",
    "inputs": {
     "input1": {
      "folder": [
       "process_weather_variable__output1__1__winter_comparison_1.csv",
       "process_weather_variable__output1__2__winter_comparison_2.csv",
       "process_weather_variable__output1__3__winter_comparison_3.csv"
      ]
     }
    },
    "outputs": {
     "output1": "plot_weather_comparison__output1__corvallis_winter_comparison.png"
    },
    "params": {},
    "packages": [
     "pandas",
     "matplotlib"
    ]
   }
  ],
  "_base": "<fixture>"
