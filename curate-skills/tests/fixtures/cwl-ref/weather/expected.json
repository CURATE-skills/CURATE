     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/download_ghcn_station.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/download_ghcn_station_main.py"
    ],
    "process_weather_variable": [
