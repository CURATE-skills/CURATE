{
 "jobs": {
  "name": "corvallis_winter_weather_comparison",
  "description": "Compare winter 2025 weather in Corvallis, Oregon (GHCN-Daily station USC00351862) against the previous 10-year daily average for PRCP, TMIN and TMAX.",
  "defaults": {
   "image": "docker:///python:3.12-slim",
   "resources": {
    "cpus": 1,
    "memory_mb": 2048
   }
  },
  "inputs": [],
  "outputs": [
   {
    "file": "plot_weather_comparison__output1__corvallis_winter_comparison.png",
    "deliver_as": "results/corvallis_winter_comparison.png"
   }
  ],
  "nodes": [
   {
    "id": "download_ghcn_station",
    "_origin": "download_ghcn_station",
