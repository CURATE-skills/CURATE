{
 "jobs": {
  "name": "t",
  "description": "",
  "defaults": {
   "image": "docker:///python:3.12-slim"
  },
  "inputs": [
   {
    "file": "data_a.csv",
    "location": "file://<fixture>/inputs/data_a.csv"
   },
   {
    "file": "data_b.csv",
    "location": "file://<fixture>/inputs/data_b.csv"
   }
  ],
  "outputs": [
   {
    "file": "m__o__a__o_a.json",
    "deliver_as": "results/a/o.json"
   },
   {
    "file": "m__o__b__o_b.json",
    "deliver_as": "results/b/o.json"
   }
  ],
  "nodes": [
   {
    "id": "m__a",
    "_origin": "m",
    "_assign": {
     "w": "a"
    },
    "code": "functions/m.py",
    "entrypoint": "main",
    "inputs": {
     "d": "data_a.csv"
    },
    "outputs": {
     "o": "m__o__a__o_a.json"
    },
    "params": {
     "w": "a",
     "f": 0.5,
     "ks": [
      1,
      2
     ],
     "n": 3,
     "on": true,
     "tag": "x"
    }
   },
   {
    "id": "m__b",
    "_origin": "m",
    "_assign": {
     "w": "b"
    },
    "code": "functions/m.py",
    "entrypoint": "main",
    "inputs": {
     "d": "data_b.csv"
    },
    "outputs": {
     "o": "m__o__b__o_b.json"
    },
    "params": {
     "w": "b",
     "f": 0.5,
     "ks": [
      1,
      2
     ],
     "n": 3,
     "on": true,
     "tag": "x"
    }
   }
  ],
  "_base": "<fixture>"
 },
 "pegasus": {
  "workflow": {
   "pegasus": "5.0.4",
   "name": "t",
   "metadata": {
    "curate.transformations": "{\"m\": {\"image\": \"docker:///python:3.12-slim\", \"resources\": {}}}",
    "curate.replicas": "{\"data_a.csv\": \"inputs/data_a.csv\", \"data_b.csv\": \"inputs/data_b.csv\", \"code__m__m.py\": \"functions/m.py\"}",
    "curate.deliverables": "[{\"file\": \"m__o__a__o_a.json\", \"deliver_as\": \"results/a/o.json\"}, {\"file\": \"m__o__b__o_b.json\", \"deliver_as\": \"results/b/o.json\"}]"
   },
   "jobs": [
    {
     "type": "job",
     "name": "m",
     "id": "m__a",
     "arguments": [
      "--code",
      "code__m__m.py",
      "--entrypoint",
      "main",
      "--in",
      "d=data_a.csv",
      "--out",
      "o=m__o__a__o_a.json",
      "--params-json",
      "'{\"w\": \"a\", \"f\": 0.5, \"ks\": [1, 2], \"n\": 3, \"on\": true, \"tag\": \"x\"}'"
     ],
     "uses": [
      {
       "lfn": "code__m__m.py",
       "type": "input"
      },
      {
       "lfn": "data_a.csv",
       "type": "input"
      },
      {
       "lfn": "m__o__a__o_a.json",
       "type": "output",
       "stageOut": true,
       "registerReplica": true
      }
     ]
    },
    {
     "type": "job",
     "name": "m",
     "id": "m__b",
     "arguments": [
      "--code",
      "code__m__m.py",
      "--entrypoint",
      "main",
      "--in",
      "d=data_b.csv",
      "--out",
      "o=m__o__b__o_b.json",
      "--params-json",
      "'{\"w\": \"b\", \"f\": 0.5, \"ks\": [1, 2], \"n\": 3, \"on\": true, \"tag\": \"x\"}'"
     ],
     "uses": [
      {
       "lfn": "code__m__m.py",
       "type": "input"
      },
      {
       "lfn": "data_b.csv",
       "type": "input"
      },
      {
       "lfn": "m__o__b__o_b.json",
       "type": "output",
       "stageOut": true,
       "registerReplica": true
      }
     ]
    }
   ],
   "jobDependencies": []
  },
  "copy": {},
  "needed": [
   "data_a.csv",
   "data_b.csv"
  ]
 },
 "faasr": {
  "workflow": {
   "FunctionInvoke": "m",
   "WorkflowName": "t",
   "DefaultDataStore": "S3",
   "LoggingDataStore": "S3",
   "FaaSrLog": "FaaSrLog",
   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "m": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "m",
     "Arguments": {
      "folder": "tf",
      "d": "data_w_csv__{rank}.csv",
      "o": "m__o__{rank}__o_{rank}.json"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "m": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
     "Region": "<FAASR_S3_REGION>",
     "AccessKey": "S3_AccessKey",
     "SecretKey": "S3_SecretKey",
     "Writable": "TRUE"
    }
   },
   "FunctionGitRepo": {
    "m": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/m.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/m_main.py"
    ]
   }
  },
  "names": {
   "data_w_csv": "data_w_csv__{rank}.csv",
   "m/o": "m__o__{rank}__o_{rank}.json"
  },
  "outputs": {
   "files": [
    {
     "action": "m",
     "file": "m__o__1__o_1.json"
    },
    {
     "action": "m",
     "file": "m__o__2__o_2.json"
    }
   ],
   "deliverables": [
    {
     "output": "o_w_json",
     "file": "m__o__1__o_1.json",
     "deliver_as": "results/a/o.json"
    },
    {
     "output": "o_w_json",
     "file": "m__o__2__o_2.json",
     "deliver_as": "results/b/o.json"
    }
   ]
  },
  "external_inputs": [
   {
    "input": "data_w_csv",
    "file": "data_w_csv__1.csv",
    "location": "file://<fixture>/inputs/data_a.csv",
    "s3_path": "tf/data_w_csv__1.csv"
   },
   {
    "input": "data_w_csv",
    "file": "data_w_csv__2.csv",
    "location": "file://<fixture>/inputs/data_b.csv",
    "s3_path": "tf/data_w_csv__2.csv"
   }
  ]
 }
}
