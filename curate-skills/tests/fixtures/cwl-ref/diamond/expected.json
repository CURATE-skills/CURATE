{
 "jobs": {
  "name": "diamond-ice-demo",
  "description": "Synthetic 4-node diamond shaped like an ice-phenology task (not the real task)",
  "defaults": {
   "image": "docker:///python:3.12-slim",
   "resources": {
    "cpus": 1,
    "memory_mb": 1024
   }
  },
  "inputs": [
   {
    "file": "params.json",
    "location": "file://<fixture>/input/params.json"
   }
  ],
  "outputs": [
   {
    "file": "assemble__result__ice_phenology_result.json",
    "deliver_as": "results/ice_phenology_result.json"
   }
  ],
  "nodes": [
   {
    "id": "load_data",
    "_origin": "load_data",
    "_assign": {},
    "code": "functions/load_data.py",
    "entrypoint": "main",
    "inputs": {
     "params": "params.json"
    },
    "outputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "params": {}
   },
   {
    "id": "freeze_up",
    "_origin": "freeze_up",
    "_assign": {},
    "code": "functions/freeze_up.py",
    "entrypoint": "main",
    "inputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "outputs": {
     "freeze": "freeze_up__freeze__freeze.csv"
    },
    "params": {
     "run_days": 5
    }
   },
   {
    "id": "ice_off",
    "_origin": "ice_off",
    "_assign": {},
    "code": "functions/ice_off.py",
    "entrypoint": "main",
    "inputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "outputs": {
     "iceoff": "ice_off__iceoff__iceoff.csv"
    },
    "params": {
     "run_days": 5
    }
   },
   {
    "id": "assemble",
    "_origin": "assemble",
    "_assign": {},
    "code": "functions/assemble.py",
    "entrypoint": "main",
    "inputs": {
     "freeze": "freeze_up__freeze__freeze.csv",
     "iceoff": "ice_off__iceoff__iceoff.csv"
    },
    "outputs": {
     "result": "assemble__result__ice_phenology_result.json"
    },
    "params": {}
   }
  ],
  "_base": "<fixture>"
 },
 "pegasus": {
  "ir": {
   "ir_version": "0.2",
   "expanded": true,
   "name": "t",
   "description": "Synthetic 4-node diamond shaped like an ice-phenology task (not the real task)",
   "defaults": {
    "image": "docker:///python:3.12-slim",
    "resources": {
     "cpus": 1,
     "memory_mb": 1024
    }
   },
   "inputs": [
    {
     "file": "params.json",
     "location": "inputs/params.json"
    }
   ],
   "nodes": [
    {
     "id": "load_data",
     "_origin": "load_data",
     "_assign": {},
     "code": "functions/load_data.py",
     "entrypoint": "main",
     "inputs": {
      "params": "params.json"
     },
     "outputs": {
      "daily": "load_data__daily__daily.csv"
     },
     "params": {}
    },
    {
     "id": "freeze_up",
     "_origin": "freeze_up",
     "_assign": {},
     "code": "functions/freeze_up.py",
     "entrypoint": "main",
     "inputs": {
      "daily": "load_data__daily__daily.csv"
     },
     "outputs": {
      "freeze": "freeze_up__freeze__freeze.csv"
     },
     "params": {
      "run_days": 5
     }
    },
    {
     "id": "ice_off",
     "_origin": "ice_off",
     "_assign": {},
     "code": "functions/ice_off.py",
     "entrypoint": "main",
     "inputs": {
      "daily": "load_data__daily__daily.csv"
     },
     "outputs": {
      "iceoff": "ice_off__iceoff__iceoff.csv"
     },
     "params": {
      "run_days": 5
     }
    },
    {
     "id": "assemble",
     "_origin": "assemble",
     "_assign": {},
     "code": "functions/assemble.py",
     "entrypoint": "main",
     "inputs": {
      "freeze": "freeze_up__freeze__freeze.csv",
      "iceoff": "ice_off__iceoff__iceoff.csv"
     },
     "outputs": {
      "result": "assemble__result__ice_phenology_result.json"
     },
     "params": {}
    }
   ],
   "outputs": [
    {
     "file": "assemble__result__ice_phenology_result.json",
     "deliver_as": "results/ice_phenology_result.json"
    }
   ]
  },
  "copy": {
   "params.json": "<fixture>/input/params.json"
  },
  "needed": []
 },
 "faasr": {
  "workflow": {
   "FunctionInvoke": "load-data",
   "WorkflowName": "t",
   "DefaultDataStore": "S3",
   "LoggingDataStore": "S3",
   "FaaSrLog": "FaaSrLog",
   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "load-data": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "load_data",
     "Arguments": {
      "folder": "tf",
      "params": "params.json",
      "daily": "load_data__daily__daily.csv"
     },
     "InvokeNext": [
      "freeze-up",
      "ice-off"
     ]
    },
    "freeze-up": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "freeze_up",
     "Arguments": {
      "folder": "tf",
      "daily": "load_data__daily__daily.csv",
      "freeze": "freeze_up__freeze__freeze.csv"
     },
     "InvokeNext": [
      "assemble"
     ]
    },
    "ice-off": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "ice_off",
     "Arguments": {
      "folder": "tf",
      "daily": "load_data__daily__daily.csv",
      "iceoff": "ice_off__iceoff__iceoff.csv"
     },
     "InvokeNext": [
      "assemble"
     ]
    },
    "assemble": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "assemble",
     "Arguments": {
      "folder": "tf",
      "freeze": "freeze_up__freeze__freeze.csv",
      "iceoff": "ice_off__iceoff__iceoff.csv",
      "result": "assemble__result__ice_phenology_result.json"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "load-data": "ghcr.io/faasr/github-actions-python:latest",
    "freeze-up": "ghcr.io/faasr/github-actions-python:latest",
    "ice-off": "ghcr.io/faasr/github-actions-python:latest",
    "assemble": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
     "Region": "<FAASR_S3_REGION>",
     "AccessKey": "S3_AccessKey",
     "SecretKey": "S3_SecretKey",
     "Writable": "TRUE"
    }
   },
   "FunctionGitRepo": {
    "load_data": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/load_data.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/load_data_main.py"
    ],
    "freeze_up": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/freeze_up.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/freeze_up_main.py"
    ],
    "ice_off": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/ice_off.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/ice_off_main.py"
    ],
    "assemble": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/assemble.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/assemble_main.py"
    ]
   }
  },
  "names": {
   "params_json": "params.json",
   "load_data/daily": "load_data__daily__daily.csv",
   "freeze_up/freeze": "freeze_up__freeze__freeze.csv",
   "ice_off/iceoff": "ice_off__iceoff__iceoff.csv",
   "assemble/result": "assemble__result__ice_phenology_result.json"
  },
  "outputs": {
   "files": [
    {
     "action": "load-data",
     "file": "load_data__daily__daily.csv"
    },
    {
     "action": "freeze-up",
     "file": "freeze_up__freeze__freeze.csv"
    },
    {
     "action": "ice-off",
     "file": "ice_off__iceoff__iceoff.csv"
    },
    {
     "action": "assemble",
     "file": "assemble__result__ice_phenology_result.json"
    }
   ],
   "deliverables": [
    {
     "output": "ice_phenology_result_json",
     "file": "assemble__result__ice_phenology_result.json",
     "deliver_as": "results/ice_phenology_result.json"
    }
   ]
  },
  "external_inputs": [
   {
    "input": "params_json",
    "file": "params.json",
    "location": "file://<fixture>/input/params.json",
    "s3_path": "tf/params.json"
   }
  ]
 }
}
