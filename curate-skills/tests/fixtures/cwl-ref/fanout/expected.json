     "daily": "load_data__daily__daily.csv"
    },
    "outputs": {
     "ice": "detect_ice__ice__2021__ice_2021.json"
    },
    "params": {
     "winter": "2021",
     "run_days": 5
    }
   },
   {
    "id": "detect_ice__2022",
    "_origin": "detect_ice",
    "_assign": {
     "winter": "2022"
    },
    "code": "functions/detect_ice.py",
    "entrypoint": "main",
    "inputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "outputs": {
     "ice": "detect_ice__ice__2022__ice_2022.json"
    },
