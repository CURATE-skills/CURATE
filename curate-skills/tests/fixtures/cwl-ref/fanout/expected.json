 "faasr": {
  "workflow": {
   "FunctionInvoke": "load-data",
   "WorkflowName": "t",
   "DefaultDataStore": "S3",
   "LoggingDataStore": "S3",
   "FaaSrLog": "FaaSrLog",
   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "load-data": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "load_data",
     "Arguments": {
      "folder": "tf",
      "params": "params.json",
      "daily": "load_data__daily__daily.csv"
     },
     "InvokeNext": [
      "detect-ice(4)"
     ]
    },
    "detect-ice": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "detect_ice",
     "Arguments": {
      "folder": "tf",
      "daily": "load_data__daily__daily.csv",
      "ice": "detect_ice__ice__{rank}__ice_{rank}.json"
     },
     "InvokeNext": [
      "add-duration(4)"
     ]
    },
    "add-duration": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "add_duration",
     "Arguments": {
      "folder": "tf",
      "ice": "detect_ice__ice__{rank}__ice_{rank}.json",
      "row": "add_duration__row__{rank}__row_{rank}.json"
     },
     "InvokeNext": [
      "assemble"
     ]
    },
    "assemble": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "assemble",
     "Arguments": {
      "folder": "tf",
      "rows": "add_duration__row__{rank}__row_{rank}.json",
      "result": "assemble__result__ice_phenology_result.json"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "load-data": "ghcr.io/faasr/github-actions-python:latest",
    "detect-ice": "ghcr.io/faasr/github-actions-python:latest",
    "add-duration": "ghcr.io/faasr/github-actions-python:latest",
    "assemble": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
     "Region": "<FAASR_S3_REGION>",
     "AccessKey": "S3_AccessKey",
     "SecretKey": "S3_SecretKey",
     "Writable": "TRUE"
    }
   },
   "FunctionGitRepo": {
    "load_data": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/load_data.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/load_data_main.py"
    ],
    "detect_ice": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/detect_ice.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/detect_ice_main.py"
    ],
    "add_duration": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/add_duration.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/add_duration_main.py"
    ],
    "assemble": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/assemble.py",
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/assemble_main.py"
    ]
   }
  },
