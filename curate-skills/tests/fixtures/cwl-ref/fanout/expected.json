{
 "jobs": {
  "name": "fanout-ice-demo",
  "description": "Same synthetic data as the diamond, computed per winter in parallel (1 -> N -> N -> 1)",
  "defaults": {
   "image": "docker:///python:3.12-slim",
   "resources": {
    "cpus": 1,
    "memory_mb": 1024
   }
  },
  "inputs": [
   {
    "file": "params.json",
    "location": "file://<fixture>/input/params.json"
   }
  ],
  "outputs": [
   {
    "file": "assemble__result__ice_phenology_result.json",
    "deliver_as": "results/ice_phenology_result.json"
   }
  ],
  "nodes": [
   {
    "id": "load_data",
    "_origin": "load_data",
    "_assign": {},
    "code": "functions/load_data.py",
    "entrypoint": "main",
    "inputs": {
     "params": "params.json"
    },
    "outputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "params": {}
   },
   {
    "id": "detect_ice__2019",
    "_origin": "detect_ice",
    "_assign": {
     "winter": "2019"
    },
    "code": "functions/detect_ice.py",
    "entrypoint": "main",
    "inputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "outputs": {
     "ice": "detect_ice__ice__2019__ice_2019.json"
    },
    "params": {
     "winter": "2019",
     "run_days": 5
    }
   },
   {
    "id": "detect_ice__2020",
    "_origin": "detect_ice",
    "_assign": {
     "winter": "2020"
    },
    "code": "functions/detect_ice.py",
    "entrypoint": "main",
    "inputs": {
     "daily": "load_data__daily__daily.csv"
    },
    "outputs": {
     "ice": "detect_ice__ice__2020__ice_2020.json"
    },
    "params": {
     "winter": "2020",
     "run_days": 5
    }
   },
   {
    "id": "detect_ice__2021",
    "_origin": "detect_ice",
    "_assign": {
     "winter": "2021"
    },
    "code": "functions/detect_ice.py",
    "entrypoint": "main",
