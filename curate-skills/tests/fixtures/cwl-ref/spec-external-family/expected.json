     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/m_main.py"
    ],
    "all3": [
     "<FAASR_GH_USERNAME>/<FAASR_ACTION_REPO>/main/functions/all3.py",
