   "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
   "ActionList": {
    "m": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "m",
     "Arguments": {
      "folder": "tf",
      "input1": "data_rank3_csv__{rank}.csv",
      "input2": "cfg.json",
      "output1": "m__output1__{rank}__part_{rank}.csv"
     },
     "InvokeNext": [
      "all3(3)",
      "g"
     ]
    },
    "all3": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "all3",
     "Arguments": {
      "folder": "tf",
      "input1": "m__output1__{rank}__part_{rank}.csv",
      "output1": "all3__output1__{rank}__seen_{rank}.txt"
     },
     "InvokeNext": [
      "g3(3)"
     ]
    },
    "g": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "g",
     "Arguments": {
      "folder": "tf",
      "input1": "m__output1__{rank}__part_{rank}.csv",
      "output1": "g__output1__sum.json"
     },
     "InvokeNext": []
    },
    "g3": {
     "FaaSServer": "My_GitHub_Account",
     "Type": "Python",
     "FunctionName": "g3",
     "Arguments": {
      "folder": "tf",
      "input1": "all3__output1__{rank}__seen_{rank}.txt",
      "output1": "g3__output1__{rank}__z_{rank}.json"
     },
     "InvokeNext": []
    }
   },
   "ActionContainers": {
    "m": "ghcr.io/faasr/github-actions-python:latest",
    "all3": "ghcr.io/faasr/github-actions-python:latest",
    "g": "ghcr.io/faasr/github-actions-python:latest",
    "g3": "ghcr.io/faasr/github-actions-python:latest"
   },
   "ComputeServers": {
    "My_GitHub_Account": {
     "FaaSType": "GitHubActions",
     "UserName": "<FAASR_GH_USERNAME>",
     "ActionRepoName": "<FAASR_ACTION_REPO>",
     "Branch": "main",
     "UseSecretStore": true
    }
   },
   "DataStores": {
    "S3": {
     "Endpoint": "<FAASR_S3_ENDPOINT>",
     "Bucket": "<FAASR_S3_BUCKET>",
